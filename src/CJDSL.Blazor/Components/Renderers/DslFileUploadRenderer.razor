@using CJDSL.Blazor.Models
@using Microsoft.JSInterop
@using MudBlazor
@using System.Text.Json

<MudStack Class="@GetStringProp("Class")">
    @if (!string.IsNullOrEmpty(Component.Label))
    {
        <MudText Typo="Typo.body1" Class="mb-1">@Component.Label</MudText>
    }

    <InputFile id="@_inputId"
               OnChange="HandleFileSelected"
               accept="@GetStringProp("Accept")"
               multiple="@GetBoolProp("Multiple")"
               disabled="@_uploading"
               style="display:none;" />

    <MudPaper Outlined="true" Class="rounded-lg pa-4" Style="min-height:120px; display:flex; align-items:center; justify-content:center; cursor:pointer; border-style:dashed !important;"
              @onclick="OpenFilePicker">
        <MudStack AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Color="Color.Default" />
            <MudText Typo="Typo.body1">
                @(_selectedFiles == null || _selectedFiles.Count == 0
                    ? GetStringProp("Placeholder", "点击选择文件")
                    : $"{_selectedFiles.Count} 个文件已选择")
            </MudText>
            @* StoreLocator 模式（链 A 契约：字段值 = Locator 字符串）：无新选文件时回显已有值的尾段文件名 *@
            @if (UseLocator && (_selectedFiles == null || _selectedFiles.Count == 0)
                && !string.IsNullOrEmpty(ExistingLocator))
            {
                <MudText Typo="Typo.caption" Color="Color.Primary">
                    已有文件：@ShortenLocator(ExistingLocator!)
                </MudText>
            }
            @if (!string.IsNullOrEmpty(GetStringProp("Hint")))
            {
                <MudText Typo="Typo.caption" Color="Color.Default">
                    @GetStringProp("Hint")
                </MudText>
            }
        </MudStack>
    </MudPaper>

    @if (_selectedFiles != null && _selectedFiles.Count > 0)
    {
        <MudList T="string">
            @foreach (var file in _selectedFiles)
            {
                <MudListItem T="string">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%">
                        <MudIcon Icon="@GetFileIcon(file.Name)" Color="Color.Default" />
                        <MudStack Style="flex:1; min-width:0">
                            <MudText Typo="Typo.body2" Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                @file.Name
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default">
                                @FormatFileSize(file.Size)
                            </MudText>
                        </MudStack>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => RemoveFile(file))" />
                    </MudStack>
                </MudListItem>
            }
        </MudList>

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       OnClick="@ClearFiles"
                       Disabled="@_uploading">
                清除
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Upload"
                       OnClick="@HandleUpload"
                       Disabled="@_uploading">
                @(_uploading ? "上传中..." : "上传")
            </MudButton>
        </MudStack>
    }
</MudStack>

@code {
    [CascadingParameter] public DslRenderContext Context { get; set; } = null!;
    [Parameter] public DslComponent Component { get; set; } = null!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;
    [Inject] private HttpClient HttpClient { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private readonly string _inputId = $"file_{Guid.NewGuid():N}";
    private List<IBrowserFile>? _selectedFiles;
    private bool _uploading;
    /// <summary>本次会话上传得到的 Locator（成功后写入，优先于 props.value 回显）。</summary>
    private string? _currentLocator;

    /// <summary>StoreLocator 模式开关：由转换器下发，不设 = 旧行为（元数据数组）完全不变。</summary>
    private bool UseLocator => GetBoolProp("StoreLocator");

    /// <summary>已有值：优先本次会话上传结果，其次 props.value（编辑/重渲染回显）。</summary>
    private string? ExistingLocator => _currentLocator ?? GetStringProp("value");

    private async Task OpenFilePicker()
    {
        // JSInterop identifier 是点分路径而非任意表达式；须经 eval 包裹，且 _inputId 用 $ 插值进 JS 串
        await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('{_inputId}').click()");
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        var maxFiles = GetIntProp("MaxFiles", 1);
        _selectedFiles = e.GetMultipleFiles(maxFiles).ToList();
        StateHasChanged();
    }

    private T? GetProp<T>(string key) => Component.Props?.GetValueOrDefault(key) is T v ? v : default;
    private string? GetStringProp(string key, string? defaultValue = null) => Component.Props?.GetValueOrDefault(key) is string v ? v : defaultValue;
    private int GetIntProp(string key, int defaultValue = 0) => Component.Props?.GetValueOrDefault(key) is int v ? v : defaultValue;
    private bool GetBoolProp(string key) => Component.Props?.GetValueOrDefault(key) is bool v ? v : false;

    private string GetFileIcon(string fileName)
    {
        var ext = System.IO.Path.GetExtension(fileName)?.ToLower() ?? "";
        return ext switch
        {
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp" or ".webp" => Icons.Material.Filled.Image,
            ".pdf" => Icons.Material.Filled.PictureAsPdf,
            ".doc" or ".docx" => Icons.Material.Filled.Description,
            ".xls" or ".xlsx" => Icons.Material.Filled.TableChart,
            ".zip" or ".rar" or ".7z" => Icons.Material.Filled.FolderZip,
            ".mp4" or ".avi" or ".mov" => Icons.Material.Filled.VideoFile,
            ".mp3" or ".wav" => Icons.Material.Filled.AudioFile,
            _ => Icons.Material.Filled.InsertDriveFile
        };
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB"];
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private void RemoveFile(IBrowserFile file)
    {
        _selectedFiles?.Remove(file);
        StateHasChanged();
    }

    private void ClearFiles()
    {
        _selectedFiles = null;
        StateHasChanged();
    }

    private async Task HandleUpload()
    {
        if (_selectedFiles == null || _selectedFiles.Count == 0) return;

        _uploading = true;
        StateHasChanged();

        try
        {
            var endpoint = GetStringProp("UploadEndpoint", "/api/upload");
            var maxFileSize = (long)GetIntProp("MaxFileSize", 10485760);
            var useLocator = UseLocator;
            var locators = new List<string>();

            foreach (var file in _selectedFiles)
            {
                using var content = new MultipartFormDataContent();
                using var stream = file.OpenReadStream(maxFileSize);
                using var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType ?? "application/octet-stream");
                content.Add(fileContent, "file", file.Name);

                var response = await HttpClient.PostAsync(endpoint, content);
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add($"{file.Name} 上传成功", Severity.Success);
                    // StoreLocator 模式：解析响应体里的 Locator（链 A 契约 = 字段值存 Locator 字符串）
                    if (useLocator)
                        locators.Add(await TryExtractLocatorAsync(response));
                }
                else
                {
                    Snackbar.Add($"{file.Name} 上传失败", Severity.Error);
                }
            }

            if (Component.FieldName != null)
            {
                if (useLocator && locators.Count > 0)
                {
                    // 链 A 契约为单文件（MaximumFileCount=1）；多文件兜底逗号拼接，不丢数据
                    var stored = locators.Count == 1 ? locators[0] : string.Join(",", locators);
                    _currentLocator = stored;
                    Context.DataStore.Set($"data.{Component.FieldName}", stored);
                }
                else
                {
                    // 旧行为（StoreLocator 未启用 / 解析不到 Locator）：存元数据数组，数据不丢
                    Context.DataStore.Set($"data.{Component.FieldName}",
                        _selectedFiles.Select(f => new { f.Name, f.Size, f.ContentType }).ToList());
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"上传失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _uploading = false;
            _selectedFiles = null;
            StateHasChanged();
        }
    }

    /// <summary>
    /// 从上传响应体解析 Locator：优先根级 locator 键，其次 data/Data 容器内 locator（均大小写不敏感）。
    /// 解析不到返回 null（调用方回退元数据数组，不丢数据）。
    /// </summary>
    private static async Task<string?> TryExtractLocatorAsync(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(body)) return null;
            using var doc = JsonDocument.Parse(body);
            var root = doc.RootElement;
            if (root.ValueKind != JsonValueKind.Object) return null;

            // ① 根级 locator
            var direct = TryReadLocator(root);
            if (direct != null) return direct;

            // ② data / Data 容器内 locator（链 A 回执 { data: { locator } } 形态）
            foreach (var p in root.EnumerateObject())
            {
                if (string.Equals(p.Name, "data", StringComparison.OrdinalIgnoreCase)
                    && p.Value.ValueKind == JsonValueKind.Object)
                {
                    var inner = TryReadLocator(p.Value);
                    if (inner != null) return inner;
                }
            }
            return null;
        }
        catch
        {
            return null;
        }
    }

    /// <summary>在对象内大小写不敏感扫描 locator 字符串键。</summary>
    private static string? TryReadLocator(JsonElement el)
    {
        foreach (var p in el.EnumerateObject())
        {
            if (string.Equals(p.Name, "locator", StringComparison.OrdinalIgnoreCase)
                && p.Value.ValueKind == JsonValueKind.String)
                return p.Value.GetString();
        }
        return null;
    }

    /// <summary>Locator 取尾段文件名显示（按 / 与 \ 分割）。</summary>
    private static string ShortenLocator(string locator)
    {
        var idx = locator.LastIndexOfAny(['/', '\\']);
        return idx >= 0 && idx < locator.Length - 1 ? locator[(idx + 1)..] : locator;
    }
}
