@using System.Text.Json
@using CJDSL.Blazor.Events
@using CJDSL.Blazor.Expressions
@using CJDSL.Blazor.Models
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject HttpClient HttpClient

@if (_isLoading)
{
    <MudStack AlignItems="AlignItems.Center" Class="pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.body1" Class="mt-4">加载中...</MudText>
    </MudStack>
}
else if (_errorMessage != null)
{
    <MudAlert Severity="Severity.Error" Class="ma-4">
        <MudText Typo="Typo.h6">加载失败</MudText>
        <MudText Typo="Typo.body2">@_errorMessage</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="RetryLoad" Class="mt-2">
            重试
        </MudButton>
    </MudAlert>
}
else if (DslPage != null)
{
    <CascadingValue Value="_context">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
            @foreach (var component in DslPage.Components)
            {
                <DslComponentRenderer Component="component" />
            }
        </MudContainer>
    </CascadingValue>
}
else
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">
        无法加载 DSL 页面
    </MudAlert>
}

@code {
    [Parameter] public DslPage? DslPage { get; set; }
    [Parameter] public UserContext? User { get; set; }
    [Parameter] public Dictionary<string, object>? InitialData { get; set; }

    private DslRenderContext _context = null!;
    private DslEventDispatcher _dispatcher = null!;
    private bool _isLoading = false;
    private string? _errorMessage = null;

    protected override void OnParametersSet()
    {
        if (DslPage != null)
        {
            _errorMessage = null;
            _isLoading = false;

            try
            {
                _context = new DslRenderContext
                {
                    Page = DslPage,
                    User = User ?? new UserContext(),
                    ExpressionEvaluator = new ClientJintEvaluator()
                };

                _dispatcher = new DslEventDispatcher(
                    HttpClient, Snackbar, Navigation, DialogService, JSRuntime);

                if (InitialData != null)
                {
                    foreach (var kv in InitialData)
                        _context.DataStore.Set($"data.{kv.Key}", kv.Value);
                }

                _context.DataStore.DataChanged += (s, e) => StateHasChanged();
            }
            catch (Exception ex)
            {
                _errorMessage = $"初始化渲染上下文失败: {ex.Message}";
                Snackbar.Add(_errorMessage, Severity.Error);
            }
        }
    }

    private void RetryLoad()
    {
        _errorMessage = null;
        StateHasChanged();
    }
}
