@using CJDSL.Blazor.Models
@using CJDSL.Blazor.Components.Renderers
@using CJDSL.Web.Services
@using MudBlazor
@inject HttpClient HttpClient
@inject ISnackbar Snackbar
@inject FloatService FloatService

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.ViewQuilt" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@(DslData?.Title ?? "DSL 预览")</MudText>
            <MudSpacer />
            <MudTooltip Text="最小化到浮窗">
                <MudIconButton Icon="@Icons.Material.Filled.PushPin"
                               Size="Size.Small"
                               Color="Color.Inherit"
                               OnClick="@MinimizeToFloat"
                               Class="mr-1" />
            </MudTooltip>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="ma-8" />
        }
        else if (DslData != null)
        {
            <MudTabs @bind-ActivePanelIndex="_activeTab" Class="mt-2">
                <MudTabPanel Text="界面" Icon="@Icons.Material.Filled.Preview">
                    <MudPaper Class="pa-4 mt-2" Outlined="true" Style="overflow-y: auto; max-height: 70vh;">
                        <DslPageRenderer DslPage="DslData" User="_user" />
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="DSL" Icon="@Icons.Material.Filled.Code">
                    <MudPaper Class="pa-4 mt-2" Outlined="true" Style="overflow-y: auto; max-height: 70vh;">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                                <MudButton StartIcon="@Icons.Material.Filled.ContentCopy"
                                           Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           OnClick="@CopyDslJson">
                                    复制
                                </MudButton>
                            </MudStack>
                            <pre style="background: var(--mud-palette-surface); padding: 16px; border-radius: 8px; overflow-x: auto; font-size: 13px; line-height: 1.5; white-space: pre-wrap; word-break: break-all;">@_dslJson</pre>
                        </MudStack>
                    </MudPaper>
                </MudTabPanel>
            </MudTabs>
        }
        else
        {
            <MudAlert Severity="Severity.Error" Class="ma-4">无法加载 DSL 数据</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close">关闭</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string PageCode { get; set; } = string.Empty;

    private CJDSL.Blazor.Models.DslPage? DslData;
    private string _dslJson = string.Empty;
    private bool _loading = true;
    private int _activeTab;

    private readonly CJDSL.Blazor.Models.UserContext _user = new()
    {
        UserId = "demo",
        UserName = "演示用户",
        Roles = ["operator", "admin"],
        Permissions = ["repair:create", "repair:edit", "repair:view"]
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDslPage();
    }

    private async Task LoadDslPage()
    {
        _loading = true;
        try
        {
            var response = await HttpClient.GetAsync($"api/dsl/page/{PageCode}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _dslJson = FormatJson(json);
                DslData = System.Text.Json.JsonSerializer.Deserialize<CJDSL.Blazor.Models.DslPage>(json, new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });
            }
            else
            {
                DslData = GetFallbackDslPage(PageCode);
                _dslJson = FormatJson(System.Text.Json.JsonSerializer.Serialize(DslData, new System.Text.Json.JsonSerializerOptions
                {
                    WriteIndented = true,
                    PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                }));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载 DSL 失败: {ex.Message}", Severity.Error);
            DslData = GetFallbackDslPage(PageCode);
            _dslJson = FormatJson(System.Text.Json.JsonSerializer.Serialize(DslData, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            }));
        }
        finally
        {
            _loading = false;
        }
    }

    private void Close() => MudDialog.Close();

    private void MinimizeToFloat()
    {
        var title = DslData?.Title ?? PageCode;
        FloatService.Add(title, PageCode, Icons.Material.Filled.ViewQuilt);
        MudDialog.Close();
    }

    private async Task CopyDslJson()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _dslJson);
        Snackbar.Add("DSL JSON 已复制到剪贴板", Severity.Success);
    }

    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;

    private static string FormatJson(string json)
    {
        try
        {
            var obj = System.Text.Json.JsonSerializer.Deserialize<object>(json);
            return System.Text.Json.JsonSerializer.Serialize(obj, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            });
        }
        catch { return json; }
    }

    private CJDSL.Blazor.Models.DslPage? GetFallbackDslPage(string pageCode) => pageCode.ToLower() switch
    {
        "repair-form" or "page_equipment_repair" => BuildRepairFormDsl(),
        "equipment-list" => BuildEquipmentListDsl(),
        "user-form" => BuildUserFormDsl(),
        "product-form" => BuildProductFormDsl(),
        "task-board" => BuildTaskBoardDsl(),
        "dashboard" => BuildDashboardDsl(),
        _ => null
    };

