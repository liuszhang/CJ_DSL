@page "/config/llm"
@rendermode RenderMode.InteractiveServer
@using CJDSL.Domain.Configuration
@using CJDSL.Infrastructure.Configuration
@inject SystemConfigService ConfigService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Class="mr-2" />LLM 源配置
</MudText>

<MudGrid>
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-6" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-4">连接配置</MudText>

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="提供商" @bind-Value="_config.Provider" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("OpenAI")">OpenAI</MudSelectItem>
                        <MudSelectItem Value="@("Ollama")">Ollama (本地)</MudSelectItem>
                        <MudSelectItem Value="@("Custom")">自定义兼容 API</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="模型名称" @bind-Value="_config.Model"
                                  Variant="Variant.Outlined" Placeholder="gpt-4o-mini" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" Label="API 基础地址" @bind-Value="_config.BaseUrl"
                                  Variant="Variant.Outlined" Placeholder="https://api.openai.com/v1/"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Link" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" Label="API Key" @bind-Value="_config.ApiKey"
                                  Variant="Variant.Outlined" Placeholder="sk-..."
                                  InputType="@(_showApiKey ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showApiKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="@(() => _showApiKey = !_showApiKey)" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField T="float" Label="温度 (Temperature)" @bind-Value="_config.Temperature"
                                     Variant="Variant.Outlined" Min="0f" Max="2f" Step="0.1f" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField T="int" Label="最大 Token 数" @bind-Value="_config.MaxTokens"
                                     Variant="Variant.Outlined" Min="256" Max="128000" Step="256" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField T="int" Label="超时时间（秒）" @bind-Value="_config.TimeoutSeconds"
                                     Variant="Variant.Outlined" Min="10" Max="600" />
                </MudItem>

                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="_config.Enabled" Label="启用 LLM 服务"
                               Color="Color.Primary" />
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-6">
                <MudButton Variant="Variant.Outlined" OnClick="@TestConnection"
                           StartIcon="@Icons.Material.Filled.WifiFind" Loading="@_testing">
                    测试连接
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveConfig"
                           StartIcon="@Icons.Material.Filled.Save">
                    保存配置
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-3">说明</MudText>
            <MudList T="string" Dense="true">
                <MudListItem T="string" Icon="@Icons.Material.Filled.Info">
                    <MudText Typo="Typo.body2">LLM 用于根据元模型和自然语言描述自动生成 DSL JSON</MudText>
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Info">
                    <MudText Typo="Typo.body2">支持 OpenAI、Ollama 及所有 OpenAI 兼容 API</MudText>
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Info">
                    <MudText Typo="Typo.body2">温度越低输出越确定，推荐 0.3</MudText>
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Info">
                    <MudText Typo="Typo.body2">测试连接将发送一条简单请求验证服务可达性</MudText>
                </MudListItem>
            </MudList>

            @if (_testResult != null)
            {
                <MudDivider Class="my-3" />
                <MudAlert Severity="@(_testSuccess ? Severity.Success : Severity.Error)" Dense="true">
                    @_testResult
                </MudAlert>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private LlmConnectionConfig _config = new();
    private bool _showApiKey;
    private bool _testing;
    private string? _testResult;
    private bool _testSuccess;

    protected override void OnInitialized()
    {
        _config = ConfigService.GetLlmConfig();
    }

    private void SaveConfig()
    {
        ConfigService.UpdateLlmConfig(_config);
        Snackbar.Add("LLM 配置已保存", Severity.Success);
    }

    private async Task TestConnection()
    {
        _testing = true;
        _testResult = null;
        StateHasChanged();

        try
        {
            using var http = new HttpClient { BaseAddress = new Uri(_config.BaseUrl), Timeout = TimeSpan.FromSeconds(10) };

            if (_config.Provider == "Ollama")
            {
                var response = await http.GetAsync("api/tags");
                if (response.IsSuccessStatusCode)
                {
                    _testSuccess = true;
                    _testResult = "Ollama 服务连接成功";
                }
                else
                {
                    _testSuccess = false;
                    _testResult = $"连接失败: {response.StatusCode}";
                }
            }
            else
            {
                // OpenAI 兼容 API - 尝试列出模型
                if (!string.IsNullOrEmpty(_config.ApiKey))
                    http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _config.ApiKey);

                var response = await http.GetAsync("models");
                if (response.IsSuccessStatusCode)
                {
                    _testSuccess = true;
                    _testResult = "API 连接成功";
                }
                else
                {
                    _testSuccess = false;
                    _testResult = $"连接失败: {response.StatusCode}";
                }
            }
        }
        catch (Exception ex)
        {
            _testSuccess = false;
            _testResult = $"连接错误: {ex.Message}";
        }
        finally
        {
            _testing = false;
            StateHasChanged();
        }
    }
}
